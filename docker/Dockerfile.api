# docker/Dockerfile.api
FROM rust:1-slim as builder

WORKDIR /usr/src/aims

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

ENV SQLX_OFFLINE=true

COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY crates ./crates
COPY .sqlx ./.sqlx

RUN cargo build --release --package aims-api

FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y ca-certificates libssl3 postgresql-client curl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/src/aims/target/release/aims-api /app/aims-api
COPY database/migrations /app/migrations

EXPOSE 8080

ENTRYPOINT ["/app/aims-api"]
