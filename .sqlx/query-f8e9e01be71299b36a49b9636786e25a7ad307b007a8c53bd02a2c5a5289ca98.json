{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                l.id,\n                l.organization_id,\n                l.employee_id,\n                e.employee_code,\n                CONCAT(e.first_name, ' ', COALESCE(e.last_name, '')) AS employee_name,\n                l.leave_type,\n                l.start_date,\n                l.end_date,\n                l.status::text AS \"status!\",\n                l.reason,\n                l.requested_by,\n                l.approved_by,\n                l.approved_at,\n                l.rejection_reason,\n                l.created_at\n            FROM leave_records l\n            JOIN employees e ON l.employee_id = e.id\n            WHERE l.organization_id = $1\n            ORDER BY l.created_at DESC\n            ",
